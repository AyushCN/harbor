# ======================
# Harbor Environment Variables
# ======================

# Application
ENV=development
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8082

# Database
DATABASE_URL=postgres://harbor:harbor@localhost:5433/harbor?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6380

# NATS
NATS_URL=nats://localhost:4222

# Authentication
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
ENCRYPTION_KEY=generate-with-openssl-rand-hex-16

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Docker
DOCKER_HOST=unix:///var/run/docker.sock
WORKSPACE_ROOT=/tmp/harbor-workspaces
DOCKER_NETWORK=harbor

# Traefik / Routing
TRAEFIK_DOMAIN=localhost

# Worker
MODE=api